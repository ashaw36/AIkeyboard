<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.AIKeyboard" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/accent_color_light</item>
        <item name="colorPrimaryVariant">@color/accent_color_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/keyboard_background_light</item>
    </style>

    <!-- Keyboard theme (Light) -->
    <style name="KeyboardTheme.Light">
        <item name="android:background">@color/keyboard_background_light</item>
    </style>

    <!-- Keyboard theme (Dark) -->
    <style name="KeyboardTheme.Dark">
        <item name="android:background">@color/keyboard_background_dark</item>
    </style>
</resources>
