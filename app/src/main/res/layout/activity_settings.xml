<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"
            android:textColor="@color/black"/>

        <!-- AI服务配置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_ai_service"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/black"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_api_key"
            android:textSize="14sp"
            android:paddingTop="8dp"
            android:textColor="@color/black"/>

        <EditText
            android:id="@+id/apiKeyEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_api_key_hint"
            android:inputType="textPassword"
            android:padding="12dp"
            android:background="@drawable/key_background"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_base_url"
            android:textSize="14sp"
            android:paddingTop="16dp"
            android:textColor="@color/black"/>

        <EditText
            android:id="@+id/baseUrlEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_base_url_hint"
            android:inputType="textUri"
            android:padding="12dp"
            android:background="@drawable/key_background"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_model"
            android:textSize="14sp"
            android:paddingTop="16dp"
            android:textColor="@color/black"/>

        <EditText
            android:id="@+id/modelEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="deepseek-chat"
            android:inputType="text"
            android:padding="12dp"
            android:background="@drawable/key_background"/>

        <!-- 测试按钮 -->
        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_test_connection"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/accent_color_light"
            android:textColor="@color/white"/>

        <!-- 状态文本 -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:paddingTop="8dp"
            android:gravity="center"/>

        <!-- 启用键盘 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_keyboard"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:textColor="@color/black"/>

        <Button
            android:id="@+id/enableKeyboardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/msg_enable_keyboard"
            android:backgroundTint="@color/ai_button_background"
            android:textColor="@color/white"/>

        <!-- 使用说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tutorial_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:textColor="@color/black"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tutorial_step1"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:textColor="@color/black"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tutorial_step2"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:textColor="@color/black"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tutorial_step3"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:textColor="@color/black"/>

        <!-- 版本信息 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_version"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="4dp"
            android:textColor="@color/black"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_version_name"
            android:textSize="14sp"
            android:textColor="@color/black"/>

    </LinearLayout>
</ScrollView>
